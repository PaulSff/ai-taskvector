      ],
      "output_ports": [
        {
          "name": "data",
          "type": "Any"
        },
        {
          "name": "error",
          "type": "str"
        }
      ]
    },
    {
      "id": "inject_payload",
      "type": "Inject",
      "controllable": false,
      "params": {},
      "name": null,

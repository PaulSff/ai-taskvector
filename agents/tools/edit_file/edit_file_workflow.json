        {
          "name": "template",
          "type": "Any"
        }
      ],
      "output_ports": [
        {
          "name": "data",
          "type": "Any"
        }
      ]
    },
    {
      "id": "error_aggregator",
      "type": "Aggregate",
      "controllable": false,
      "params": {

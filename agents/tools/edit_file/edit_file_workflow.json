    },
    {
      "id": "error_prompt",
      "type": "Prompt",
      "controllable": true,
      "params": {
        "template": "The following errors occurred during the file edit process:\n\n{error_find_and_replace}\n\n{error_edit_file}"
      },
      "name": null,
      "input_ports": [
        {
          "name": "data",
          "type": "Any"
        }
      ],
      "output_ports": [
        {
          "name": "system_prompt",
          "type": "str"
        },
        {
          "name": "user_message",
          "type": "str"
        }
      ]
    }

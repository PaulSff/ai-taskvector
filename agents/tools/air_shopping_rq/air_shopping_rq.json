{
  "environment_type": "travel",
  "environments": [
    "canonical",
    "taskvector",
    "travel"
  ],
  "keep_alive": false,
  "units": [
    {
      "id": "inject_request",
      "type": "Inject",
      "controllable": false,
      "params": {},
      "name": null,
      "input_ports": [
        {
          "name": "template",
          "type": "Any"
        }
      ],
      "output_ports": [
        {
          "name": "data",
          "type": "Any"
        }
      ]
    },
    {
      "id": "json2xml",
      "type": "NdcJsonToXml",
      "controllable": false,
      "params": {
        "sequence_file": "units/travel/json2ndc_xml/sequences/sequences-172.json"
      },
      "name": null,
      "input_ports": [
        {
          "name": "data",
          "type": "JsonValue"
        }
      ],
      "output_ports": [
        {
          "name": "xml",
          "type": "str"
        },
        {
          "name": "error",
          "type": "str"
        }
      ]
    },
    {
      "id": "xml2json",
      "type": "NdcXmlToJson",
      "controllable": false,
      "params": {
        "singleton_file": "units/travel/ndc_xml2json/singletons/singletons-172.json"
      },
      "name": null,
      "input_ports": [
        {
          "name": "data",
          "type": "Any"
        }
      ],
      "output_ports": [
        {
          "name": "json",
          "type": "JsonValue"
        },
        {
          "name": "error",
          "type": "str"
        }
      ]
    },
    {
      "id": "request",
      "type": "NdcAirShoppingRQ",
      "controllable": false,
      "params": {
        "url": "settings.ndc_air_shopping_rq_url",
        "username": "settings.ndc_air_shopping_rq_username",
        "password": "settings.ndc_air_shopping_rq_password",
        "timeout": "30",
        "retries": "3",
        "retry_delay": "1",
        "headers": {
          "Content-Type": "application/xml",
          "Accept": "application/xml",
          "PriceTTLMaxHours": "24"
        }
      },
      "name": null,
      "input_ports": [
        {
          "name": "xml_request",
          "type": "str"
        }
      ],
      "output_ports": [
        {
          "name": "xml_response",
          "type": "str"
        },
        {
          "name": "error",
          "type": "str"
        }
      ]
    },
    {
      "id": "flight_cal",
      "type": "BuildFlightCal",
      "controllable": false,
      "params": {
        "max_offers": 50
      },
      "name": null,
      "input_ports": [
        {
          "name": "data",
          "type": "JsonValue"
        }
      ],
      "output_ports": [
        {
          "name": "item",
          "type": "JsonValue"
        },
        {
          "name": "error",
          "type": "str"
        }
      ]
    },
    {
      "id": "aggregate_response",
      "type": "Aggregate",
      "controllable": false,
      "params": {
        "num_inputs": 2,
        "keys": [
          "low_fare_flight_calendar",
          "errors"
        ]
      },
      "name": null,
      "input_ports": [
        {
          "name": "data",
          "type": "Any"
        },
        {
          "name": "in_0",
          "type": "Any"
        },
        {
          "name": "in_1",
          "type": "Any"
        }
      ],
      "output_ports": [
        {
          "name": "data",
          "type": "Any"
        },
        {
          "name": "error",
          "type": "str"
        }
      ]
    },
    {
      "id": "prompt",
      "type": "Prompt",
      "controllable": false,
      "params": {
        "template": "Low-fare flight calendar:\n{low_fare_flight_calendar}\n\nThe search results are saved into metadata.file_path.\n\n"
      },
      "name": null,
      "input_ports": [
        {
          "name": "data",
          "type": "Any"
        }
      ],
      "output_ports": [
        {
          "name": "system_prompt",
          "type": "str"
        },
        {
          "name": "user_message",
          "type": "str"
        }
      ]
    }
  ],
  "connections": [
    {
      "from": "inject_request",
      "to": "json2xml",
      "from_port": "0",
      "to_port": "0",
      "connection_type": null
    },
    {
      "from": "json2xml",
      "to": "request",
      "from_port": "0",
      "to_port": "0",
      "connection_type": null
    },
    {
      "from": "request",
      "to": "xml2json",
      "from_port": "0",
      "to_port": "0",
      "connection_type": null
    },
    {
      "from": "xml2json",
      "to": "flight_cal",
      "from_port": "0",
      "to_port": "0",
      "connection_type": null
    },
    {
      "from": "flight_cal",
      "to": "aggregate_response",
      "from_port": "0",
      "to_port": "1",
      "connection_type": null
    },
    {
      "from": "aggregate_response",
      "to": "prompt",
      "from_port": "0",
      "to_port": "0",
      "connection_type": null
    }
  ],
  "code_blocks": [
  ],
  "layout": null,
  "origin": {
    "canonical": true,
    "node_red": null,
    "pyflow": null,
    "n8n": null,
    "ryven": null,
    "comfyui": null
  },
  "origin_format": "dict",
  "runtime": "native",
  "tabs": null,
  "metadata": {
    "description": "AirShoppingRQ tool workflow: This workflow requests flight offers via IATA NDC AirShoppingRQ request and gets them formatted into a prompt - str."
  },
  "comments": [
  ],
  "todo_lists": []
}

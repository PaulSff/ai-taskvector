{
  "units": [
    {
      "id": "inject_url",
      "type": "Inject",
      "controllable": false,
      "params": {},
      "input_ports": [{ "name": "template", "type": "Any" }],
      "output_ports": [{ "name": "data", "type": "Any" }]
    },
    {
      "id": "browser",
      "type": "browser",
      "controllable": false,
      "params": {},
      "input_ports": [{ "name": "in", "type": "str" }],
      "output_ports": [
        { "name": "out", "type": "str" },
        { "name": "error", "type": "str" }
      ]
    },
    {
      "id": "beautifulsoup",
      "type": "beautifulsoup",
      "controllable": false,
      "params": { "mode": "text" },
      "input_ports": [{ "name": "in", "type": "str" }],
      "output_ports": [
        { "name": "out", "type": "str" },
        { "name": "error", "type": "str" }
      ]
    }
  ],
  "connections": [
    { "from": "inject_url", "to": "browser", "from_port": "0", "to_port": "0" },
    {
      "from": "browser",
      "to": "beautifulsoup",
      "from_port": "0",
      "to_port": "0"
    }
  ],
  "metadata": {
    "description": "This workflow fetches URL and extracts its text via browser + BeautifulSoup"
  }
}

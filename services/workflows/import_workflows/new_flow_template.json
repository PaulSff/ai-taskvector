{
  "environment_type": "messengers",
  "environments": [
    "canonical",
    "messengers",
    "taskvector",
    "time"
  ],
  "keep_alive": true,
  "units": [
    {
      "id": "On_Off",
      "type": "WorkflowTrigger",
      "controllable": false,
      "params": {
        "default_payload": {
          "action": "start"
        }
      },
      "name": null,
      "input_ports": [
        {
          "name": "payload",
          "type": "Any"
        }
      ],
      "output_ports": [
        {
          "name": "payload",
          "type": "Any"
        },
        {
          "name": "graph",
          "type": "Any"
        }
      ]
    },
    {
      "id": "tg_bot",
      "type": "TelegramBot",
      "controllable": true,
      "params": {
        "_needs_executor": true,
        "_unit_id": "tg_bot",
        "bot_token": "tool.get_chats.telegram.bot_token",
        "wait_for_delivery": true,
        "delivery_timeout_s": 60,
        "zmq_sub_endpoint": "tool.get_chats.mq.zmq_sub_endpoint",
        "update_endpoint": "tool.get_chats.mq.zmq_update_endpoint",
        "response_endpoint": "tool.get_chats.mq.zmq_response_endpoint",
        "workflow_path": "tool.get_chats.workflow"
      },
      "name": null,
      "input_ports": [
        {
          "name": "tg_start",
          "type": "Any"
        },
        {
          "name": "tg_stop",
          "type": "Any"
        },
        {
          "name": "get_unread",
          "type": "Any"
        },
        {
          "name": "send_message",
          "type": "Any"
        },
        {
          "name": "raw",
          "type": "Any"
        }
      ],
      "output_ports": [
        {
          "name": "update",
          "type": "Any"
        },
        {
          "name": "status",
          "type": "Any"
        },
        {
          "name": "error",
          "type": "Any"
        }
      ]
    },
    {
      "id": "delay",
      "type": "DelayLoop",
      "controllable": false,
      "params": {
        "_needs_executor": true,
        "update_interval_s": 60,
        "payload": {
          "action": "get_unread",
          "messenger": "telegram"
        }
      },
      "name": null,
      "input_ports": [
        {
          "name": "start",
          "type": "Any"
        },
        {
          "name": "stop",
          "type": "Any"
        },
        {
          "name": "payload",
          "type": "Any"
        }
      ],
      "output_ports": [
        {
          "name": "out",
          "type": "Any"
        },
        {
          "name": "error",
          "type": "Any"
        }
      ]
    },
    {
      "id": "router",
      "type": "Router",
      "controllable": false,
      "params": {
        "routes": [
          {
            "port": "out_0",
            "all": [
              {
                "any_item": {
                  "field": "update.chats",
                  "rule": {
                    "field": "unread_count",
                    "gt": 0
                  }
                }
              }
            ]
          },
          {
            "port": "default",
            "default": true,
            "parser_output": {
              "action": "check_todo"
            }
          }
        ]
      },
      "name": null,
      "input_ports": [
        {
          "name": "data",
          "type": "Any"
        }
      ],
      "output_ports": [
        {
          "name": "out_0",
          "type": "Any"
        },
        {
          "name": "default",
          "type": "Any"
        }
      ]
    },
    {
      "id": "check_todo",
      "type": "CheckTodo",
      "controllable": false,
      "params": {},
      "name": null,
      "input_ports": [
        {
          "name": "check_todo",
          "type": "Any"
        },
        {
          "name": "graph",
          "type": "Any"
        }
      ],
      "output_ports": [
        {
          "name": "tasks_todo",
          "type": "Any"
        },
        {
          "name": "error",
          "type": "Any"
        }
      ]
    }
  ],
  "connections": [
    {
      "from": "On_Off",
      "to": "delay",
      "from_port": "0",
      "to_port": "0",
      "connection_type": null
    },
    {
      "from": "delay",
      "to": "tg_bot",
      "from_port": "0",
      "to_port": "0",
      "connection_type": null
    },
    {
      "from": "tg_bot",
      "to": "router",
      "from_port": "0",
      "to_port": "0",
      "connection_type": null
    },
    {
      "from": "router",
      "to": "check_todo",
      "from_port": "1",
      "to_port": "0",
      "connection_type": null
    }
  ],
  "code_blocks": [
  ],
  "layout": {},
  "origin": {
    "canonical": true,
    "node_red": null,
    "pyflow": null,
    "n8n": null,
    "ryven": null,
    "comfyui": null
  },
  "origin_format": "dict",
  "runtime": "native",
  "tabs": null,
  "metadata": {
    "description": "New workflow template: Handles new telegram messages, checks TODOs, runs the agentic loop with either unread messages or todo tasks discovered."
  },
  "comments": [
